POSTGRES_DB=backlinkstudio
POSTGRES_USER=backlinkstudio
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKLINKSTUDIO_BOOTSTRAP_API_KEY=bls_replace-with-at-least-32-random-characters
BACKLINKSTUDIO_BOOTSTRAP_NAME=Local Administrator
REDIS_PASSWORD=replace-with-a-different-long-random-password
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.159.0
SERPER_API_KEY=
WORKER_CONCURRENCY=4
WORKER_BUFFER_SIZE=8
WORKER_GLOBAL_CONCURRENCY=64
WORKER_PROJECT_CONCURRENCY=4
WORKER_CAMPAIGN_CONCURRENCY=2
WORKER_DOMAIN_CONCURRENCY=1
API_RATE_LIMIT_PERMITS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
MCP_RATE_LIMIT_PERMITS=60
MCP_RATE_LIMIT_WINDOW_SECONDS=60
OPERATIONAL_METRICS_POLL_SECONDS=15
OPERATIONAL_METRICS_WORKER_STALE_SECONDS=60
DOMAIN_REQUEST_INTERVAL_MS=1000
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_CLAIM_LEASE_SECONDS=300
SCHEDULER_LEASE_RENEWAL_SECONDS=30
SCHEDULER_FAILURE_RETRY_SECONDS=30
# Test harness only. Production startup fails if this is true.
BACKLINKSTUDIO_TEST_OWNERSHIP_OVERRIDE=false
BACKLINKSTUDIO_TEST_ALLOWED_HOSTS=
CONTROLLED_BROWSER_ENABLED=true
CONTROLLED_BROWSER_CONCURRENCY=2
CONTROLLED_BROWSER_NAVIGATION_TIMEOUT_MS=20000
CONTROLLED_BROWSER_ACTION_TIMEOUT_MS=10000
CONTROLLED_BROWSER_MAX_DOM_BYTES=2097152
CONTROLLED_BROWSER_CHROMIUM_SANDBOX=true
WORDPRESS_FALLBACK_MAX_STRATEGIES=4
# Verification remains bounded; 10 MiB is the validated hard maximum.
VERIFICATION_MAX_RESPONSE_BYTES=10485760
