{
  "OperationalMetrics": {
    "PollIntervalSeconds": 15,
    "WorkerStaleSeconds": 60
  },
  "Urls": "http://0.0.0.0:8082",
  "Reporting": {
    "StoragePath": "data/reports"
  },
  "Worker": {
    "Enabled": true,
    "Concurrency": 4,
    "BufferSize": 8,
    "PollIntervalMilliseconds": 1000,
    "ClaimLeaseSeconds": 300,
    "LeaseRenewalSeconds": 30,
    "HeartbeatIntervalSeconds": 10,
    "GlobalConcurrency": 64,
    "PerProjectConcurrency": 4,
    "PerCampaignConcurrency": 2,
    "PerDomainConcurrency": 1,
    "RetryBaseDelaySeconds": 2,
    "RetryMaximumDelaySeconds": 900
  },
  "Scheduler": {
    "Enabled": false,
    "PollIntervalMilliseconds": 1000,
    "ClaimLeaseSeconds": 300,
    "LeaseRenewalSeconds": 30,
    "FailureRetrySeconds": 30
  },
  "JobPlatform": {
    "PerDomainRequestIntervalMilliseconds": 1000,
    "MaximumRateLimitWaitSeconds": 300
  },
  "AnalysisHttp": {
    "TimeoutSeconds": 20,
    "MaximumResponseBytes": 2097152,
    "MaximumRedirects": 5,
    "UserAgent": "BacklinkStudio-Analyzer/0.2 (+authorized SEO analysis)"
  },
  "DiscoveryHttp": {
    "TimeoutSeconds": 20,
    "MaximumResponseBytes": 2097152,
    "MaximumRedirects": 5,
    "UserAgent": "BacklinkStudio-Discovery/0.3 (+authorized SEO discovery)"
  },
  "Serper": {
    "Endpoint": "https://google.serper.dev/search"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
